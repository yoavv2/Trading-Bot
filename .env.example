POSTGRES_DB=trading_platform
POSTGRES_USER=trading_platform
POSTGRES_PASSWORD=trading_platform
TRADING_PLATFORM_APP__ENVIRONMENT=local
TRADING_PLATFORM_API__PORT=8000
TRADING_PLATFORM_LOGGING__LEVEL=INFO
TRADING_PLATFORM_DATABASE__HOST=localhost
TRADING_PLATFORM_DATABASE__PORT=5432

# Polygon.io market-data provider — required for live bar ingestion and metadata refresh.
# Get your API key at https://polygon.io/dashboard
TRADING_PLATFORM_MARKET_DATA__POLYGON__API_KEY=your_polygon_api_key_here

# Exchange calendar (default: XNYS for NYSE — covers all configured US equity symbols)
# TRADING_PLATFORM_MARKET_DATA__CALENDAR__EXCHANGE=XNYS

# local development enables Job mutations (ORCH-07; default is disabled)
TRADING_PLATFORM_ORCHESTRATION__MUTATIONS_ENABLED=true

# Research assistant (plan S5): disabled until ALL of these are set and the API restarted.
# No numerical spending budget is approved; set the request cap and output-token limit to
# values you decide. Provider-console spending limits are a separate control.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# TRADING_PLATFORM_RESEARCH__AI__ENABLED=true
# TRADING_PLATFORM_RESEARCH__AI__MAX_REQUESTS_PER_DAY=20
# TRADING_PLATFORM_RESEARCH__AI__MAX_OUTPUT_TOKENS=4000
# optional: TRADING_PLATFORM_RESEARCH__AI__MODEL=claude-haiku-5-5   (default; configurable, never substituted)
#           TRADING_PLATFORM_RESEARCH__AI__TIMEOUT_SECONDS=60 (overall deadline, both attempts)
#           TRADING_PLATFORM_RESEARCH__AI__MAX_INPUT_CHARACTERS=20000
#           TRADING_PLATFORM_RESEARCH__AI__MAX_REVISIONS_PER_DRAFT=5
#           TRADING_PLATFORM_RESEARCH__AI__MAX_CONCURRENT_REQUESTS=1
